"""API 路由 - 包含页面渲染和增强 API"""
import sys
import os,json,re,time
from pathlib import Path
from datetime import datetime,timedelta
from typing import List,Dict,Optional
from fastapi import APIRouter,Query,Body,Request
from fastapi.responses import HTMLResponse,JSONResponse,FileResponse
from fastapi.templating import Jinja2Templates
from loguru import logger

sys_path=os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.path.insert(0,sys_path)
from app.database import get_db
from app.utils.tfidf_matcher import TFIDFMatcher
from app.utils.notifications import get_notif_manager
from app.utils.pdf_generator import get_pdf_generator

router=APIRouter()
_templates=Jinja2Templates(directory=str(Path(__file__).parent.parent/"templates"))

_cache={"projects":[],"total":0,"last_load":0}

def _load_projects():
    now=time.time()
    if _cache["projects"] and(now-_cache["last_load"])<60:
        return _cache["projects"],_cache["total"]
    data_file=Path(sys_path)/"output"/"latest.json"
    if data_file.exists():
        try:
            with open(data_file,encoding="utf-8")as f:d=json.load(f)
            _cache["projects"]=d.get("projects",[]);_cache["total"]=d.get("total",0);_cache["last_load"]=now
            return _cache["projects"],_cache["total"]
        except:pass
    return [],0

def _clear_cache():_cache["projects"]=[];_cache["last_load"]=0

# ========== 页面渲染 ==========
@router.get("/", response_class=HTMLResponse)
async def index(request: Request):
    db=get_db();projects,total=_load_projects()
    std={"total":total,"last_run":"-","matched":len([p for p in projects if p.get("keywords_matched")])}
    if(Path(sys_path)/"output"/"latest.json").exists():
        try:
            with open(Path(sys_path)/"output"/"latest.json",encoding="utf-8")as f:d=json.load(f);std["last_run"]=d.get("last_run","-")
        except:pass
    std["db_stats"]=db.get_stats()
    return _templates.TemplateResponse(request, "dashboard.html", {"request":request,"stats":std})

