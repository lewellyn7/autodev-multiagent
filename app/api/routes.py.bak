    for b in backups:b.pop("config_data",None)
    return JSONResponse({"backups":backups})
@router.post("/api/config/restore/{backup_id}")
def restore_backup(backup_id):
    b=get_db().restore_config(backup_id)
    if not b:return JSONResponse({"error":"backup not found"},status_code=404)
    return JSONResponse({"backup":b})

def _do_export(projects,segment_by):
    from app.utils.report import ReportGenerator
    gen=ReportGenerator(str(Path(sys_path)/"output"))
    std=[{"title":p.get("title",""),"type":p.get("tender_type",p.get("type","")),"publish_date":p.get("publish_date",""),"budget":p.get("budget",""),"url":p.get("url",""),"source_url":p.get("source_url",""),"keywords_matched":p.get("keywords_matched",""),"contact_name":p.get("contact_name",""),"contact_phone":p.get("contact_phone","")}for p in projects]
    if segment_by=="date":
        by={}
        for p in projects:d=p.get("publish_date","未知")[:10];by.setdefault(d,[]).append(p)
        files=[]
        for k,items in by.items():
            sp=[{"title":i.get("title",""),"type":i.get("tender_type",""),"publish_date":i.get("publish_date",""),"budget":i.get("budget",""),"url":i.get("url",""),"source_url":i.get("source_url",""),"keywords_matched":i.get("keywords_matched","")}for i in items]
            f2=gen.generate_excel(sp,f"export_{k}")
            if f2:files.append({"key":k,"file":f2,"count":len(items)})
        return JSONResponse({"files":files,"segments":len(files)})
    elif segment_by=="type":
        by={}
        for p in projects:t=p.get("tender_type",p.get("type","未知"));by.setdefault(t,[]).append(p)
        files=[]
        for k,items in by.items():
            sp=[{"title":i.get("title",""),"type":i.get("tender_type",""),"publish_date":i.get("publish_date",""),"budget":i.get("budget",""),"url":i.get("url",""),"source_url":i.get("source_url",""),"keywords_matched":i.get("keywords_matched","")}for i in items]
            f2=gen.generate_excel(sp,f"export_{k}")
            if f2:files.append({"key":k,"file":f2,"count":len(items)})
        return JSONResponse({"files":files,"segments":len(files)})
    else:
        f2=gen.generate_excel(std,"export");return JSONResponse({"file":f2,"count":len(projects)})
@router.get("/api/export/excel")
def export_excel(keyword:str=Query(""),category:str=Query(""),date_start:str=Query(""),date_end:str=Query(""),segment_by:str=Query("")):
    projects,_=_load_projects()
    if keyword:
        kws=[k.strip().lower()for k in keyword.split(",")if k.strip()]
        projects=[p for p in projects if any(kw in p.get("title","").lower()for kw in kws)]
    if category:projects=[p for p in projects if p.get("tender_type")==category or p.get("type")==category]
    if date_start:projects=[p for p in projects if p.get("publish_date","")>=date_start]
    if date_end:projects=[p for p in projects if p.get("publish_date","")<=date_end]
    return _do_export(projects,segment_by)
@router.get("/api/export/pdf")
def export_pdf(keyword:str=Query(""),category:str=Query(""),date_start:str=Query(""),date_end:str=Query(""),segment_by:str=Query("")):
    projects,_=_load_projects()
    if keyword:
        kws=[k.strip().lower()for k in keyword.split(",")if k.strip()]
        projects=[p for p in projects if any(kw in p.get("title","").lower()for kw in kws)]
    if category:projects=[p for p in projects if p.get("tender_type")==category or p.get("type")==category]
    if date_start:projects=[p for p in projects if p.get("publish_date","")>=date_start]
    if date_end:projects=[p for p in projects if p.get("publish_date","")<=date_end]
    g=get_pdf_generator()
    if not g.available:return JSONResponse({"error":"PDF not available"},status_code=503)
    if segment_by:
        files=g.generate_segmented(projects,segment_by);return JSONResponse({"files":files,"count":len(files)})
    else:
        f=g.generate_report(projects)
        if f:return JSONResponse({"file":f,"count":len(projects)})
        return JSONResponse({"error":"PDF generation failed"},status_code=500)
