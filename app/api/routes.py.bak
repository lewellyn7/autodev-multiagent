@router.get("/api/duplicates")
def find_duplicates(threshold:float=Query(0.7,ge=0,le=1)):
    db=get_db();projects,_=_load_projects()
    if not projects:return JSONResponse({"duplicates":[],"total":0})
    m=TFIDFMatcher(min_similarity=threshold);m.build_corpus([p.get("title","")for p in projects])
    groups=[];checked=set()
    for i,p1 in enumerate(projects):
        u1=p1.get("url","")
        if u1 in checked:continue
        group=[{"url":u1,"title":p1.get("title",""),"similarity":1.0}]
        for j,p2 in enumerate(projects[i+1:],i+1):
            u2=p2.get("url","")
            if u2 in checked:continue
            sim=m.title_similarity(p1.get("title",""),p2.get("title",""))
            if sim>=threshold:
                group.append({"url":u2,"title":p2.get("title",""),"similarity":round(sim,3)});checked.add(u2)
                db.add_duplicate(u1,u2,p2.get("title",""),sim)
        if len(group)>1:
            groups.append(group)
            for item in group:checked.add(item["url"])
    return JSONResponse({"duplicates":groups,"total":len(groups)})
@router.get("/api/analytics")
def get_analytics(days:int=Query(30,ge=1,le=365)):
    projects,_=_load_projects()
    if not projects:return JSONResponse({"trend":{},"budget_dist":{},"keyword_heat":{},"source_dist":{}})
    cutoff=(datetime.now()-timedelta(days=days)).strftime("%Y-%m-%d")
    recent=[p for p in projects if p.get("publish_date","")>=cutoff]
    trend={}
    for p in recent:
        d=p.get("publish_date","")[:10]
        if not d:continue
        trend[d]=trend.get(d,{"total":0,"gov":0,"eng":0});trend[d]["total"]+=1
        t=p.get("tender_type","")
        if "政府"in t:trend[d]["gov"]+=1
        elif "工程"in t:trend[d]["eng"]+=1
    br={"0-10万":0,"10-50万":0,"50-100万":0,"100-500万":0,"500万+":0}
    for p in recent:
        b=p.get("budget","")
        if not b:continue
        try:
            n=float(re.sub(r"[^\d.]","",b))*(10000 if "万"in b else 1)
            if n<100000:br["0-10万"]+=1
            elif n<500000:br["10-50万"]+=1
            elif n<1000000:br["50-100万"]+=1
            elif n<5000000:br["100-500万"]+=1
            else:br["500万+"]+=1
        except:pass
    kwc={}
    for p in recent:
        kw=p.get("keywords_matched","")
        if kw:
            for k in kw.split(","):
                k=k.strip()
                if k:kwc[k]=kwc.get(k,0)+1
    kwh=dict(sorted(kwc.items(),key=lambda x:x[1],reverse=True)[:20])
    sd={}
    for p in recent:
        try:
            src=p.get("source_url","")or p.get("url","")
            src=src.split("/")[2]if "//"in src else src[:30]
            sd[src]=sd.get(src,0)+1
        except:pass
    return JSONResponse({"trend":trend,"budget_dist":br,"keyword_heat":kwh,"source_dist":dict(sorted(sd.items(),key=lambda x:x[1],reverse=True)[:10]),"total_count":len(recent),"days":days})
