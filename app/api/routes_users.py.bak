"""用户管理 API"""
import sys, os, json, hashlib, time, secrets
from pathlib import Path
from datetime import datetime
from typing import Optional
from fastapi import APIRouter, HTTPException, Body, Query, Header, Request
from loguru import logger

sys_path = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.path.insert(0, sys_path)

from app.core.permissions import get_perm_config
from app.database import get_db

router = APIRouter(prefix="/api/users", tags=["用户管理"])

_sessions = {}

def _hash_password(password: str, salt: str = None) -> tuple:
    if salt is None:
        salt = secrets.token_hex(16)
    pwd_hash = hashlib.pbkdf2_hmac('sha256', password.encode(), salt.encode(), 100000).hex()
    return pwd_hash, salt

def _verify_password(password: str, pwd_hash: str, salt: str) -> bool:
    return _hash_password(password, salt)[0] == pwd_hash

def _create_session(user_id: str) -> str:
    token = secrets.token_urlsafe(32)
    _sessions[token] = {"user_id": user_id, "expires": time.time() + 7 * 86400}
    return token

def _get_session(token: str) -> Optional[dict]:
    s = _sessions.get(token)
    if s and s["expires"] > time.time():
        return s
    if token in _sessions:
        del _sessions[token]
    return None

def _get_user_id(x_session_token: str = Header(None)) -> Optional[str]:
    if not x_session_token:
        return None
    s = _get_session(x_session_token)
    return s["user_id"] if s else None

# 注册
@router.post("/register")
async def register(username: str = Body(...), password: str = Body(...), display_name: str = Body(None)):
    db = get_db()
    if db.get_user_by_username(username):
        raise HTTPException(status_code=400, detail="用户名已存在")
    pwd_hash, salt = _hash_password(password)
    user_id = db.create_user({"username": username, "password_hash": pwd_hash, "password_salt": salt, "display_name": display_name or username, "role": "viewer", "enabled": True, "created_at": datetime.now().isoformat()})
    if not user_id:
        raise HTTPException(status_code=500, detail="注册失败")
    return {"success": True, "user_id": user_id, "username": username, "role": "viewer", "session_token": _create_session(user_id)}

# 登录
@router.post("/login")
async def login(username: str = Body(...), password: str = Body(...)):
    db = get_db()
    user = db.get_user_by_username(username)
    if not user or not _verify_password(password, user["password_hash"], user["password_salt"]):
        raise HTTPException(status_code=401, detail="用户名或密码错误")
    if not user.get("enabled", True):
        raise HTTPException(status_code=403, detail="账户已被禁用")
    db.update_user_last_login(user["user_id"])
    return {"success": True, "user_id": user["user_id"], "username": user["username"], "role": user.get("role", "viewer"), "session_token": _create_session(user["user_id"])}

# 登出
@router.post("/logout")
async def logout(x_session_token: str = Header(None, alias="X-Session-Token")):
    if x_session_token and x_session_token in _sessions:
        del _sessions[x_session_token]
    return {"success": True}

# 当前用户
@router.get("/me")
async def get_me(x_session_token: str = Header(None, alias="X-Session-Token")):
    uid = _get_user_id(x_session_token)
    if not uid:
        raise HTTPException(status_code=401, detail="未登录")
    db = get_db()
    user = db.get_user_by_id(uid)
    if not user:
        raise HTTPException(status_code=404, detail="用户不存在")
    return {"user_id": user["user_id"], "username": user["username"], "display_name": user.get("display_name"), "role": user.get("role"), "enabled": user.get("enabled", True)}

# 修改密码
@router.post("/change-password")
async def change_password(old_password: str = Body(...), new_password: str = Body(...), x_session_token: str = Header(None, alias="X-Session-Token")):
    uid = _get_user_id(x_session_token)
    if not uid:
        raise HTTPException(status_code=401, detail="未登录")
    db = get_db()
    user = db.get_user_by_id(uid)
    if not _verify_password(old_password, user["password_hash"], user["password_salt"]):
        raise HTTPException(status_code=400, detail="旧密码错误")
    pwd_hash, salt = _hash_password(new_password)
    db.update_user_password(uid, pwd_hash, salt)
    return {"success": True, "message": "密码已更新"}

# ========== 管理员接口 ==========

@router.get("/admin/list")
async def admin_list(x_session_token: str = Header(None, alias="X-Session-Token"), page: int = Query(1, ge=1), page_size: int = Query(20, ge=1, le=100), role: str = Query(None)):
    uid = _get_user_id(x_session_token)
    if not uid:
        raise HTTPException(status_code=401, detail="未登录")
    if not get_perm_config().is_admin(uid):
        raise HTTPException(status_code=403, detail="需要管理员权限")
    db = get_db()
    users, total = db.list_users_paged(page=page, page_size=page_size, role=role)
    for u in users:
        u.pop("password_hash", None)
        u.pop("password_salt", None)
    return {"users": users, "total": total, "page": page}

@router.post("/admin/create")
async def admin_create(username: str = Body(...), password: str = Body(...), display_name: str = Body(None), role: str = Body("viewer"), enabled: bool = Body(True), x_session_token: str = Header(None, alias="X-Session-Token")):
    uid = _get_user_id(x_session_token)
    if not uid or not get_perm_config().is_admin(uid):
        raise HTTPException(status_code=403, detail="需要管理员权限")
    if role not in ["guest", "viewer", "operator", "admin"]:
        raise HTTPException(status_code=400, detail="无效角色")
    db = get_db()
    if db.get_user_by_username(username):
        raise HTTPException(status_code=400, detail="用户名已存在")
    pwd_hash, salt = _hash_password(password)
    new_id = db.create_user({"username": username, "password_hash": pwd_hash, "password_salt": salt, "display_name": display_name or username, "role": role, "enabled": enabled, "created_at": datetime.now().isoformat()})
    return {"success": True, "user_id": new_id}

@router.patch("/admin/update/{target_uid}")
async def admin_update(target_uid: str, display_name: str = Body(None), role: str = Body(None), enabled: bool = Body(None), x_session_token: str = Header(None, alias="X-Session-Token")):
    uid = _get_user_id(x_session_token)
    if not uid or not get_perm_config().is_admin(uid):
        raise HTTPException(status_code=403, detail="需要管理员权限")
    if target_uid == uid and role and role != "admin":
        raise HTTPException(status_code=400, detail="不能取消自己的管理员权限")
    db = get_db()
    updates = {}
    if display_name is not None: updates["display_name"] = display_name
    if role is not None: updates["role"] = role
    if enabled is not None: updates["enabled"] = enabled
    if updates:
        db.update_user(target_uid, updates)
    return {"success": True}

@router.delete("/admin/delete/{target_uid}")
async def admin_delete(target_uid: str, x_session_token: str = Header(None, alias="X-Session-Token")):
    uid = _get_user_id(x_session_token)
    if not uid or not get_perm_config().is_admin(uid):
        raise HTTPException(status_code=403, detail="需要管理员权限")
    if target_uid == uid:
        raise HTTPException(status_code=400, detail="不能删除自己")
    db = get_db()
    db.delete_user(target_uid)
    return {"success": True, "message": "用户已删除"}

@router.post("/admin/reset-password/{target_uid}")
async def admin_reset_pwd(target_uid: str, new_password: str = Body(...), x_session_token: str = Header(None, alias="X-Session-Token")):
    uid = _get_user_id(x_session_token)
    if not uid or not get_perm_config().is_admin(uid):
        raise HTTPException(status_code=403, detail="需要管理员权限")
    pwd_hash, salt = _hash_password(new_password)
    get_db().update_user_password(target_uid, pwd_hash, salt)
    return {"success": True, "message": "密码已重置"}

@router.get("/stats")
async def get_stats(x_session_token: str = Header(None, alias="X-Session-Token")):
    uid = _get_user_id(x_session_token)
    if not uid or not get_perm_config().is_admin(uid):
        raise HTTPException(status_code=403, detail="需要管理员权限")
    return get_db().get_user_stats()
