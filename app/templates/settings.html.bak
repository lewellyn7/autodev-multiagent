{% extends "base.html" %}
{% block content %}
<div class="toast-container" id="toastContainer"></div>
<div x-data="enhancedSettings()" x-init="init()" class="space-y-6">
  <div class="border-b border-gray-200 dark:border-gray-700">
    <nav class="flex gap-1 -mb-px">
      <button @click="activeTab='notifications'" class="px-4 py-2 text-sm font-medium border-b-2" :class="activeTab==='notifications' ? 'border-blue-600 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500'">通知设置</button>
      <button @click="activeTab='presets'" class="px-4 py-2 text-sm font-medium border-b-2" :class="activeTab==='presets' ? 'border-blue-600 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500'">筛选预设</button>
      <button @click="activeTab='backup'" class="px-4 py-2 text-sm font-medium border-b-2" :class="activeTab==='backup' ? 'border-blue-600 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500'">配置备份</button>
      <button @click="activeTab='duplicates'" class="px-4 py-2 text-sm font-medium border-b-2" :class="activeTab==='duplicates' ? 'border-blue-600 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500'">重复检测</button>
    </nav>
  </div>
  <!-- Notifications Tab -->
  <div x-show="activeTab==='notifications'" class="space-y-4">
    <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Telegram 推送设置</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="space-y-4">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" x-model="notif.enabled" class="w-5 h-5 rounded text-blue-600">
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">启用 Telegram 通知</span>
          </label>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Bot Token</label>
            <input type="password" x-model="notif.bot_token" class="w-full border rounded px-3 py-2 bg-white dark:bg-gray-700 dark:border-gray-600 text-sm" placeholder="123456:ABC-DEF...">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Chat ID</label>
            <input type="text" x-model="notif.chat_id" class="w-full border rounded px-3 py-2 bg-white dark:bg-gray-700 dark:border-gray-600 text-sm" placeholder="-1001234567890">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">最低预算阈值 (万元，留空不限)</label>
            <input type="text" x-model="notif.min_budget" class="w-full border rounded px-3 py-2 bg-white dark:bg-gray-700 dark:border-gray-600 text-sm" placeholder="100">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">推送阈值 (达到N条后推送)</label>
            <input type="number" x-model="notif.notify_on_count" min="1" class="w-full border rounded px-3 py-2 bg-white dark:bg-gray-700 dark:border-gray-600 text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">关键词过滤 (逗号分隔，留空推送所有匹配)</label>
            <input type="text" x-model="notif.keywords_str" class="w-full border rounded px-3 py-2 bg-white dark:bg-gray-700 dark:border-gray-600 text-sm" placeholder="智慧城市, 数字化, 智能化">
          </div>
          <div class="flex gap-3 mt-4">
            <button @click="saveNotifConfig()" class="anim-btn class="px-4 py-2 bg-blue-600 text-white rounded text-sm hover:bg-blue-700">保存通知设置</button>
            <button @click="testNotification()" class="anim-btn class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded text-sm hover:bg-gray-300 dark:hover:bg-gray-600">发送测试</button>
          </div>
          <p x-show="notifMsg" class="mt-2 text-sm" :class="notifMsg.startsWith('ERROR') ? 'text-red-600' : 'text-green-600'" x-text="notifMsg"></p>
        </div>
        <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 text-sm text-gray-600 dark:text-gray-400">
          <h3 class="font-medium text-gray-700 dark:text-gray-300 mb-2">配置说明</h3>
          <ul class="space-y-1 list-disc list-inside">
            <li>Bot Token: 从 @BotFather 获取</li>
            <li>Chat ID: 使用 @userinfobot 获取</li>
            <li>最低预算: 只推送预算不低于此值的项目</li>
            <li>关键词过滤: 只有包含指定关键词才会推送</li>
            <li>推送阈值: 积累N条匹配项目后发送汇总通知</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <!-- Presets Tab -->
  <div x-show="activeTab==='presets'" class="space-y-4">
    <div class="flex justify-between items-center">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">筛选预设</h2>
      <button @click="openPresetModal()" class="anim-btn class="px-4 py-2 bg-blue-600 text-white rounded text-sm hover:bg-blue-700">+ 新建预设</button>
    </div>
    <div class="anim-card bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 dark:bg-gray-900">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">名称</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">关键词</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">类型</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">日期范围</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">默认</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
          <template x-for="p in presets" :key="p.id">
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
              <td class="px-4 py-3 font-medium text-gray-900 dark:text-white" x-text="p.name"></td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400" x-text="p.filter_config?.keyword || '-'"></td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400" x-text="p.filter_config?.category || '-'"></td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400" x-text="(p.filter_config?.date_start || '-') + ' ~ ' + (p.filter_config?.date_end || '-')"></td>
              <td class="px-4 py-3"><span x-show="p.is_default" class="text-xs bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 px-2 py-0.5 rounded">默认</span></td>
              <td class="px-4 py-3 text-right">
                <button @click="loadPresetToForm(p)" class="text-blue-600 hover:text-blue-800 text-xs mr-2">编辑</button>
                <button @click="deletePreset(p.preset_key)" class="text-red-600 hover:text-red-800 text-xs">删除</button>
              </td>
            </tr>
          </template>
          <tr x-show="presets.length === 0">
            <td colspan="6" class="px-4 py-8 text-center text-gray-400">暂无预设</td>
          </tr>
        </tbody>
      </table>
    </div>
    <!-- Preset Modal -->
    <div x-show="showPresetModal" x-cloak class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
      <div @click.outside="showPresetModal = false" class="bg-white dark:bg-gray-800 rounded-lg p-6 w-full max-w-lg shadow-xl">
        <h3 class="text-lg font-bold mb-4 text-gray-900 dark:text-white" x-text="editingPreset ? '编辑预设' : '新建预设'"></h3>
        <div class="space-y-4">
          <div><label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">预设名称</label><input type="text" x-model="presetForm.name" class="w-full border rounded px-3 py-2 bg-white dark:bg-gray-700 dark:border-gray-600"></div>
          <div><label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">预设Key (唯一标识)</label><input type="text" x-model="presetForm.preset_key" class="w-full border rounded px-3 py-2 bg-white dark:bg-gray-700 dark:border-gray-600" placeholder="my_preset_1"></div>
          <div><label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">关键词 (逗号分隔)</label><input type="text" x-model="presetForm.keyword" class="w-full border rounded px-3 py-2 bg-white dark:bg-gray-700 dark:border-gray-600" placeholder="智慧城市, 数字化"></div>
          <div><label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">项目类型</label><input type="text" x-model="presetForm.category" class="w-full border rounded px-3 py-2 bg-white dark:bg-gray-700 dark:border-gray-600" placeholder="政府采购"></div>
          <div class="grid grid-cols-2 gap-4">
            <div><label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">开始日期</label><input type="date" x-model="presetForm.date_start" class="w-full border rounded px-3 py-2 bg-white dark:bg-gray-700 dark:border-gray-600"></div>
            <div><label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">结束日期</label><input type="date" x-model="presetForm.date_end" class="w-full border rounded px-3 py-2 bg-white dark:bg-gray-700 dark:border-gray-600"></div>
          </div>
          <label class="flex items-center gap-2"><input type="checkbox" x-model="presetForm.is_default" class="w-4 h-4 rounded text-blue-600"><span class="text-sm text-gray-700 dark:text-gray-300">设为默认预设</span></label>
        </div>
        <div class="flex gap-3 justify-end mt-6">
          <button @click="showPresetModal = false" class="px-4 py-2 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded">取消</button>
          <button @click="savePreset()" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">保存</button>
        </div>
      </div>
    </div>
  </div>
  <!-- Backup Tab -->
  <div x-show="activeTab==='backup'" class="space-y-4">
    <div class="flex justify-between items-center">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">配置备份与恢复</h2>
      <div class="flex gap-2">
        <button @click="backupConfig()" class="anim-btn class="px-4 py-2 bg-blue-600 text-white rounded text-sm hover:bg-blue-700">创建备份</button>
        <label class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded text-sm cursor-pointer hover:bg-gray-300 dark:hover:bg-gray-600">
          导入配置<input type="file" @change="importConfig($event)" accept=".json" class="hidden">
        </label>
      </div>
    </div>
    <div class="anim-card bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 dark:bg-gray-900">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">版本</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">描述</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">创建时间</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
          <template x-for="b in backups" :key="b.id">
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
              <td class="px-4 py-3 font-medium text-gray-900 dark:text-white" x-text="b.version_label"></td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400" x-text="b.description || '-'"></td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs" x-text="b.created_at ? b.created_at.replace('T',' ').slice(0,19) : '-'"></td>
              <td class="px-4 py-3 text-right">
                <button @click="restoreBackup(b.id)" class="text-blue-600 hover:text-blue-800 text-xs mr-2">恢复</button>
                <button @click="exportBackup(b)" class="text-green-600 hover:text-green-800 text-xs">导出</button>
              </td>
            </tr>
          </template>
          <tr x-show="backups.length === 0">
            <td colspan="4" class="px-4 py-8 text-center text-gray-400">暂无备份</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
  <!-- Duplicates Tab -->
  <div x-show="activeTab==='duplicates'" class="space-y-4">
    <div class="flex justify-between items-center">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">重复项目检测</h2>
      <div class="flex gap-3 items-center">
        <label class="text-sm text-gray-600 dark:text-gray-400">相似度阈值:</label>
        <input type="range" x-model="dupThreshold" min="0.3" max="0.95" step="0.05" class="w-32">
        <span class="text-sm font-mono w-12" x-text="dupThreshold"></span>
        <button @click="findDuplicates()" class="anim-btn class="px-4 py-2 bg-blue-600 text-white rounded text-sm hover:bg-blue-700">检测</button>
      </div>
    </div>
    <div x-show="dupLoading" class="text-center py-12 text-gray-500">检测中...</div>
    <div x-show="!dupLoading && dupGroups.length === 0" class="text-center py-12 text-gray-400">
      <p>点击"检测"按钮开始重复项目检测</p>
    </div>
    <div class="space-y-3" x-show="!dupLoading && dupGroups.length > 0">
      <p class="text-sm text-gray-500 dark:text-gray-400">发现 <span class="font-bold text-red-500" x-text="dupGroups.length"></span> 组重复项目</p>
      <template x-for="(group, gi) in dupGroups" :key="gi">
        <div class="anim-card bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
          <p class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">重复组 #<span x-text="gi + 1"></span> (<span x-text="group.length"></span> 个)</p>
          <div class="space-y-2">
            <template x-for="(item, ii) in group" :key="ii">
              <div class="flex items-center gap-3 text-sm" :class="ii > 0 ? 'ml-4 pl-4 border-l-2 border-gray-300 dark:border-gray-600' : ''">
                <span class="text-xs px-2 py-0.5 rounded" :class="ii === 0 ? 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-200' : 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-200'" x-text="ii === 0 ? '原始' : '重复'"></span>
                <span class="flex-1 text-gray-900 dark:text-gray-200 truncate" x-text="item.title"></span>
                <span class="text-xs text-gray-500 font-mono" x-show="ii > 0" x-text="(item.similarity * 100).toFixed(0) + '%'"></span>
                <a :href="item.url" target="_blank" class="text-blue-500 hover:text-blue-700 text-xs shrink-0">查看</a>
              </div>
            </template>
          </div>
        </div>
      </template>
    </div>
  </div>
</div>
<script>
function enhancedSettings() {
  var _showToast = showToast;

  return {
    activeTab: "notifications",
    notif: { enabled: false, bot_token: "", chat_id: "", min_budget: "", keywords_filter: [], notify_on_count: 1, keywords_str: "" },
    notifMsg: "",
    presets: [],
    showPresetModal: false,
    editingPreset: null,
    presetForm: { name: "", preset_key: "", keyword: "", category: "", date_start: "", date_end: "", is_default: false },
    backups: [],
    dupThreshold: 0.7,
    dupGroups: [],
    dupLoading: false,
    async init() { await this.loadNotifConfig(); await this.loadPresets(); await this.loadBackups(); },
    async loadNotifConfig() { const r = await fetch("/api/notifications/config"); const d = await r.json(); this.notif = { ...d, keywords_str: (d.keywords_filter||[]).join(", ") }; },
    async saveNotifConfig() { this.notifMsg=""; const kws = this.notif.keywords_str.split(",").map(k=>k.trim()).filter(Boolean); const r = await fetch("/api/notifications/config",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({...this.notif,keywords_filter:kws})}); const d = await r.json(); this.notifMsg = d.success ? "保存成功!" : "保存失败"; },
    async testNotification() { this.notifMsg=""; const r = await fetch("/api/notifications/test",{method:"POST"}); const d = await r.json(); this.notifMsg = d.success ? "测试消息已发送!" : "发送失败: "+(d.error||"未知错误"); },
    async loadPresets() { const r = await fetch("/api/presets"); const d = await r.json(); this.presets = d.presets||[]; },
    openPresetModal() { this.editingPreset=null; this.presetForm={name:"",preset_key:"",keyword:"",category:"",date_start:"",date_end:"",is_default:false}; this.showPresetModal=true; },
    loadPresetToForm(p) { this.editingPreset=p; this.presetForm={name:p.name,preset_key:p.preset_key,keyword:p.filter_config?.keyword||"",category:p.filter_config?.category||"",date_start:p.filter_config?.date_start||"",date_end:p.filter_config?.date_end||"",is_default:!!p.is_default}; this.showPresetModal=true; },
    async savePreset() { await fetch("/api/presets",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({name:this.presetForm.name,preset_key:this.presetForm.preset_key,filter_config:{keyword:this.presetForm.keyword,category:this.presetForm.category,date_start:this.presetForm.date_start,date_end:this.presetForm.date_end},is_default:this.presetForm.is_default})}); this.showPresetModal=false; await this.loadPresets(); },
    async deletePreset(key) { if(!confirm("确认删除此预设?"))return; await fetch("/api/presets/"+key,{method:"DELETE"}); await this.loadPresets(); },
    async loadBackups() { const r = await fetch("/api/config/backups"); const d = await r.json(); this.backups = d.backups||[]; },
    async backupConfig() { const label = prompt("请输入备份版本标签:","v"+new Date().toISOString().slice(0,10).replace(/-/g,"")); if(!label)return; const desc = prompt("描述 (可选):","")||""; const sr = await fetch("/api/settings"); const st = await sr.json(); await fetch("/api/config/backup",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({version_label:label,config_data:st,description:desc})}); await this.loadBackups(); alert("备份已创建: "+label); },
    async restoreBackup(id) { if(!confirm("确认恢复此备份? 当前配置将被覆盖."))return; const r = await fetch("/api/config/restore/"+id,{method:"POST"}); const d = await r.json(); if(d.backup&&d.backup.config_data){await fetch("/api/settings",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(d.backup.config_data)}); alert("配置已恢复!");} },
    async exportBackup(b) { const r = await fetch("/api/config/restore/"+b.id,{method:"POST"}); const d = await r.json(); if(d.backup){const blob=new Blob([JSON.stringify(d.backup.config_data,null,2)],{type:"application/json"});const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download=b.version_label+".json";a.click();URL.revokeObjectURL(url);} },
    async importConfig(event) { const file=event.target.files[0]; if(!file)return; const text=await file.text(); try{const data=JSON.parse(text);await fetch("/api/settings",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(data)});alert("配置已导入!");}catch(e){alert("导入失败: "+e);} },
    async findDuplicates() { this.dupLoading=true; try{const r=await fetch("/api/duplicates?threshold="+this.dupThreshold);const d=await r.json();this.dupGroups=d.duplicates||[];}finally{this.dupLoading=false;} }
  }
}
</script>
{% endblock %}
